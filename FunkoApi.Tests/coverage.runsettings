<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[FunkoApi.Back]*</Include>
          <Exclude>[FunkoApi.Back]Program,[FunkoApi.Back]Program+*,[FunkoApi.Back]FunkoApi.Back.Services.Funko.FunkoServices,[FunkoApi.Back]FunkoApi.Back.Services.Funko.FunkoServices+*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
