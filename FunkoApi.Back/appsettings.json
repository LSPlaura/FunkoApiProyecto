{
  "Api": {
    "Nombre": "Funko API",
    "Mensaje": "Modo base"
  },
  "Cache": {
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 10
  },
  "Postgres": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "funkos",
    "User": ""
  },
  "MongoDb": {
    "Host": "localhost",
    "Port": 27017,
    "Database": "funkos",
    "User": ""
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "RedisInstanceName":"FunkoApi"
  },
  "Jwt": {
    "Key": "CLAVE_JWT_POR_DEFECTO",
    "Issuer": "FunkoApi",
    "Audience": "FunkoApiClients",
    "ExpireMinutes": "30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/productos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "ProductosConfigLogging"
    }
  }
}